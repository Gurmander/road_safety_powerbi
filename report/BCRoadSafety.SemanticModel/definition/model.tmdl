model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["stg_Crashes","stg_Vehicles","chk_UnmatchedMunicipalities","chk_VehiclesWithoutCrashes","dim_Municipality","dim_Year"]

annotation PBI_ProTooling = ["DevMode"]

ref table stg_Crashes
ref table stg_Vehicles
ref table dim_Municipality
ref table dim_Year

ref cultureInfo en-CA

