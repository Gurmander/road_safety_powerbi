model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_Crashes","fact_Vehicles","chk_UnmatchedMunicipalities","chk_VehiclesWithoutCrashes","dim_Municipality","dim_Year","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_Crashes
ref table fact_Vehicles
ref table dim_Municipality
ref table dim_Year
ref table _Measures

ref cultureInfo en-CA

